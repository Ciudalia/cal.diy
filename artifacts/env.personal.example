# Plantilla SIN secretos reales — copiar a artifacts/secrets-local/env.destino.runtime
# Generar secretos localmente (nunca en git ni en el tar OCI):
#   NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   CALENDSO_ENCRYPTION_KEY=$(openssl rand -base64 24)
#   POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

POSTGRES_USER=caldiy
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_LOCALLY
POSTGRES_DB=calendso
DATABASE_HOST=database:5432
DATABASE_URL=postgresql://caldiy:CHANGE_ME_GENERATE_LOCALLY@database:5432/calendso
DATABASE_DIRECT_URL=postgresql://caldiy:CHANGE_ME_GENERATE_LOCALLY@database:5432/calendso

NEXT_PUBLIC_WEBAPP_URL=https://agenda.ciudalia.com
NEXT_PUBLIC_WEBSITE_URL=https://agenda.ciudalia.com
NEXT_PUBLIC_EMBED_LIB_URL=https://agenda.ciudalia.com/embed/embed.js
NEXTAUTH_URL=https://agenda.ciudalia.com
NEXT_PUBLIC_API_V2_URL=https://agenda.ciudalia.com/api/v2
ALLOWED_HOSTNAMES='"agenda.ciudalia.com"'

NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
CALENDSO_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_24
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
CRON_API_KEY=CHANGE_ME_openssl_rand_hex_16

NEXT_PUBLIC_LICENSE_CONSENT=agree
CALCOM_TELEMETRY_DISABLED=1
ORGANIZATIONS_ENABLED=
NEXT_PUBLIC_SINGLE_ORG_SLUG=
CSP_POLICY=

# Sumidero SMTP interno (Mailpit en compose destino). NO SMTP externo.
EMAIL_FROM=noreply@agenda.ciudalia.com
EMAIL_FROM_NAME="Cal.diy"
EMAIL_SERVER_HOST=mailpit
EMAIL_SERVER_PORT=1025

NEXT_PUBLIC_APP_NAME=Cal.diy
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=help@agenda.ciudalia.com
NEXT_PUBLIC_COMPANY_NAME=Ciudalia

NODE_ENV=production
REDIS_URL=redis://redis:6379
WEB_APP_URL=https://agenda.ciudalia.com
API_KEY_PREFIX=cal_
LOG_LEVEL=warn
