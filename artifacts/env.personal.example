# Plantilla SIN secretos reales — copiar a artifacts/secrets-local/env.personal
# Generar secretos localmente:
#   NEXTAUTH_SECRET=$(openssl rand -base64 32)
#   CALENDSO_ENCRYPTION_KEY=$(openssl rand -base64 24)
#   POSTGRES_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)
#
# Nunca commitear artifacts/secrets-local/

POSTGRES_USER=caldiy_test
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_LOCALLY
POSTGRES_DB=calendso
DATABASE_HOST=database:5432
DATABASE_URL=postgresql://caldiy_test:CHANGE_ME_GENERATE_LOCALLY@database:5432/calendso
DATABASE_DIRECT_URL=postgresql://caldiy_test:CHANGE_ME_GENERATE_LOCALLY@database:5432/calendso
BUILD_DATABASE_URL=postgresql://caldiy_test:CHANGE_ME_GENERATE_LOCALLY@127.0.0.1:5432/calendso

NEXT_PUBLIC_WEBAPP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_WEBSITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_EMBED_LIB_URL=http://127.0.0.1:3000/embed/embed.js
NEXTAUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_V2_URL=http://127.0.0.1:3000/api/v2
ALLOWED_HOSTNAMES='"127.0.0.1:3000","localhost:3000"'

NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
CALENDSO_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_24
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
CRON_API_KEY=CHANGE_ME_openssl_rand_hex_16

NEXT_PUBLIC_LICENSE_CONSENT=agree
CALCOM_TELEMETRY_DISABLED=1
ORGANIZATIONS_ENABLED=
NEXT_PUBLIC_SINGLE_ORG_SLUG=
CSP_POLICY=

# SMTP de prueba local (MailHog / descartar). NO enviar correo real.
EMAIL_FROM=noreply@localhost.test
EMAIL_FROM_NAME="Cal.diy Test"
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025

NEXT_PUBLIC_APP_NAME=Cal.diy
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=help@localhost.test
NEXT_PUBLIC_COMPANY_NAME=Ciudalia Test

NODE_ENV=production
REDIS_URL=redis://redis:6379
WEB_APP_URL=http://127.0.0.1:3000
API_KEY_PREFIX=cal_
LOG_LEVEL=warn
